# Word/Office lock files created while a document is open
~$*

# ---- Runtime artefacts ---------------------------------------------------
*.log
logs/
*.db
*.sqlite
*.sqlite3

# ---- Governance runtime state --------------------------------------------
# governance/*.py (policy, gates, ledger, audit_cli) ARE tracked.
# The VerbaLedger itself is runtime state and is not.
# The VSL spec requires data/ledger.jsonl to be gitignored.
data/ledger.jsonl
data/ledger*.jsonl
data/*.ledger
audit-export/
.verba/

# ---- Uploaded claim documents (synthetic, but not source-controlled) ------
data/uploads/
!data/uploads/.gitkeep

# ---- Lodged claims (development store, runtime state not seed data) -------
# Seed data in data/synthetic/ IS tracked. Claims lodged at runtime are not.
data/claims/
!data/claims/.gitkeep

# ---- Local scratch -------------------------------------------------------
tmp/
.scratch/

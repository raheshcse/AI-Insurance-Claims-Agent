# AI-Powered Insurance Claims Agent — example configuration
#
# Copy this file to `.env` and fill in real values. Never commit `.env`.
#   PowerShell:  Copy-Item .env.example .env
#
# Configuration is never hard-coded into agent or governance logic — every value
# below is read from the environment.
#
# `.env` is loaded EXPLICITLY by backend/bootstrap.py. Installing python-dotenv
# does not load it; nothing reads this file until load_project_env() runs. An
# exported shell variable overrides the file (override=False).

# ----------------------------------------------------------------------------
# Application
# ----------------------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO

# ----------------------------------------------------------------------------
# Backend API (FastAPI) — Phase 1
# ----------------------------------------------------------------------------
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
# Comma-separated origins allowed to call the API (the React dev server).
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ----------------------------------------------------------------------------
# Frontend (React) — Phase 1
# ----------------------------------------------------------------------------
VITE_API_BASE_URL=http://127.0.0.1:8000

# ----------------------------------------------------------------------------
# LLM provider — Phase 2, extended in Phase 4A
# The provider is accessed through a provider-independent interface.
# LLM_PROVIDER selects the adapter. NEVER put a real credential in this file.
# ----------------------------------------------------------------------------
# Choices:
#   stub     deterministic, offline, no key                      (default)
#   gemini   Google Gemini, Interactions API                     GEMINI_API_KEY
#   ollama   a model running on this machine                     NO KEY
#   openai | azure-openai | openai-compatible | http
#            any OpenAI-compatible /chat/completions endpoint     OPENAI_API_KEY
#
# The LLM contributes NARRATIVE only. Every value a decision turns on -- status,
# band, flag, confidence, routing outcome -- is derived by rule in the agent. An
# LLM outage degrades the prose and changes no decision. Nothing in
# backend/routing/ or governance/ imports an LLM module, and a test asserts it.
#
# Selecting a provider is not the same as reaching one. A provider with no key
# or an unreachable endpoint falls back to deterministic narration and reports
# llm_degraded=true in the analysis result. Check which happened with:
#     python -m llm.verify_cli --provider gemini
LLM_PROVIDER=stub

# -- Google Gemini (Phase 4A) -------------------------------------------------
# Get a key from Google AI Studio. Paste it into your own .env, never here.
# The key is read from the environment and nowhere else: never logged, never
# returned by the API, never in an exception message. Diagnostics report
# existence only -- `configured: true  ****wxyz`. Check with:
#     python -m llm.verify_cli
# GEMINI_MODEL default is gemini-3.8-flash. Older `:generateContent` is legacy;
# this project targets the current Interactions API.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_TEMPERATURE=0
GEMINI_MAX_OUTPUT_TOKENS=400
GEMINI_REQUEST_TIMEOUT_SECONDS=30

# -- Ollama: a model running on THIS machine (no key, no quota) ---------------
# Start the server with `ollama serve`, then `ollama pull qwen3:8b`.
#
# NO API KEY. Ollama is local and authenticates nothing. Never put a cloud
# credential here -- a local endpoint that accepted one would be a way to hand
# it to whatever is listening on port 11434.
#
# HARDWARE NOTE. qwen3:8b at 4-bit is roughly 5 GB of weights. On 16 GB of RAM
# with no usable GPU (integrated Radeon with ~0.5 GB VRAM cannot hold a model
# of this size), inference runs on the CPU at a few tokens per second, so one
# structured extraction can take 20-60 seconds. That is why the timeout below
# is 120s rather than Gemini's 30s. If that is too slow to work with, `qwen3:4b`
# is roughly half the size and about twice the speed.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_TEMPERATURE=0
OLLAMA_REQUEST_TIMEOUT_SECONDS=120

# -- OpenAI-compatible endpoints ----------------------------------------------
# Gemini also publishes an OpenAI-compatibility endpoint, so this adapter can
# reach Gemini with no new code:
#   LLM_PROVIDER=openai-compatible
#   LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#   OPENAI_API_KEY=<your Gemini key>   # note: a Gemini key in an OpenAI variable
#   LLM_MODEL=gemini-3.8-flash
# Google documents that layer as beta and says unsupported parameters are
# SILENTLY ignored, so LLM_PROVIDER=gemini is preferred for Gemini.
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1
LLM_TEMPERATURE=0
LLM_REQUEST_TIMEOUT_SECONDS=60
OPENAI_API_KEY=

# ----------------------------------------------------------------------------
# Synthetic data — Phase 0/1
# POC uses synthetic data only. No real customer, policy or claim data.
# ----------------------------------------------------------------------------
SYNTHETIC_DATA_DIR=./data/synthetic
USE_SYNTHETIC_DATA=true

# Development claim store (JSON Lines). Gitignored runtime state, replaced by a
# real database in Phase 6.
CLAIMS_STORE_PATH=./data/claims/claims.jsonl

# Claims intelligence results (Phase 2). A separate store from claims, so running
# the workflow can never mutate a claim record.
ANALYSES_STORE_PATH=./data/claims/analyses.jsonl

# Conversational assistant state (Phase 5). One record per conversation, saved
# per turn. NOT a claim store: a claim is created once, by the existing claim
# service, and the conversation then holds only its ID.
CONVERSATIONS_STORE_PATH=./data/claims/conversations.jsonl

# Human review queue (Phase 3). One entry per escalated claim.
REVIEW_QUEUE_STORE_PATH=./data/claims/review_queue.jsonl

# ----------------------------------------------------------------------------
# Governance (X-Verba / VSL) — Phase 4, implemented
#
# Key names follow the supplied VSL governance spec. Every VALUE below is a
# POC PROPOSAL awaiting business approval — see docs/DECISION_TABLE.md §7.
# Do not present these as insurer-approved thresholds.
# ----------------------------------------------------------------------------
# Append-only hash-chained VerbaLedger. Gitignored. fsync=True in production.
VSL_LEDGER_PATH=data/ledger.jsonl

# The business decision boundary for the automation PreNode. policy.py reads it.
# Gamma is computed relative to THIS boundary, never a hard-coded 0.5.
# At 0.80, the effective automation confidence floor is p >= 0.815
# (because ROBUST_GAMMA_DEFAULT_THRESHOLD = 1.1 is a VSL-Core constant).
DECISION_THRESHOLD=0.80

# Declared calibration error of the confidence estimate.
CONFIDENCE_CALIBRATION_ERROR=0.10

# Claim value thresholds, NZD. The authority limit is INV-02, evaluated at the
# automated-action commitment point (CP-14) on the claim's own facts: above it,
# the automated claim action is denied, whatever the confidence and whatever the
# routing layer proposed.
AUTOMATED_AUTHORITY_LIMIT_NZD=20000
HIGH_VALUE_REVIEW_THRESHOLD_NZD=10000
LOW_VALUE_AUTOMATION_BAND_NZD=5000
HIGH_COMPLEXITY_VALUE_NZD=20000

# Complexity and risk banding (docs/DECISION_TABLE.md 2.1 and 2.3).
# Read in Phase 2 by backend/app/domain/thresholds.py; they move to
# governance/policy.py in Phase 4, where they become governance policy.
LOW_COMPLEXITY_MAX_ITEMS=1
HIGH_COMPLEXITY_MIN_ITEMS=3
RISK_MEDIUM_INDICATOR_COUNT=1
RISK_HIGH_INDICATOR_COUNT=2

# Audit check 1 tolerance. A low-traffic system can fail this by being idle.
MAX_MONITOR_GAP_SECONDS=3600

# ----------------------------------------------------------------------------
# Persistence — POC storage location (production storage is a Phase 6 concern)
# ----------------------------------------------------------------------------
DATABASE_URL=
